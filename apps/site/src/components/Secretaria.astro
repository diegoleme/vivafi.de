---
import { describeRecurrence, type Parish } from '@vivafide/core';
import Icone from './Icone.astro';
import { formatPhone, telUrl, whatsappUrl } from '../lib/links';

/**
 * Atendimento e meios de falar com a secretaria, no mesmo bloco.
 *
 * Sem coluna de rótulos: "Telefone" ao lado de um número e "WhatsApp" ao lado
 * de "Falar via WhatsApp" repetem o que o ícone e o próprio conteúdo já dizem.
 * O horário lê como horário; o telefone e o WhatsApp leem como ação.
 */
interface Props { parish: Parish }
const { parish } = Astro.props;
const c = parish.contact;

const atendimento = [...
  parish.officeHours.reduce((m, h) => {
    const k = describeRecurrence(h.recurrence);
    const faixa = h.startsAt ? (h.endsAt ? `${h.startsAt} - ${h.endsAt}` : h.startsAt) : null;
    return m.set(k, [...(m.get(k) ?? []), ...(faixa ? [faixa] : [])]);
  }, new Map<string, string[]>())
].map(([quando, faixas]) => ({ quando, faixas: [...new Set(faixas)].sort() }));

const temAcao = Boolean(c?.phone || c?.whatsapp || c?.email);
const temAlgo = atendimento.length > 0 || temAcao;
---

{temAlgo && (
  <section aria-labelledby="t-secretaria" class="mt-20">
    <h2 id="t-secretaria" class="titulo-secao">Secretaria</h2>

    {atendimento.length > 0 && (
      <div class="mt-4">
        {atendimento.map((a) => (
          <p class="text-sm">
            {a.quando}
            {a.faixas.length > 0 && <span class="tabular text-ink-muted"> · {a.faixas.join(', ')}</span>}
          </p>
        ))}
      </div>
    )}

    {temAcao && (
      <ul
        role="list"
        class:list={['flex flex-wrap gap-x-5 gap-y-2 text-sm', atendimento.length > 0 ? 'mt-3' : 'mt-4']}
      >
        {c?.phone && (
          <li>
            <a href={telUrl(c.phone)} class="inline-flex items-center gap-1.5 underline underline-offset-2">
              <Icone nome="telefone" /><span class="tabular">{formatPhone(c.phone)}</span>
            </a>
          </li>
        )}
        {c?.whatsapp && (
          <li>
            <a href={whatsappUrl(c.whatsapp)} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 underline underline-offset-2">
              <Icone nome="whatsapp" />Falar via WhatsApp
            </a>
          </li>
        )}
        {c?.email && (
          <li class="break-all">
            <a href={`mailto:${c.email}`} class="underline underline-offset-2">{c.email}</a>
          </li>
        )}
      </ul>
    )}
  </section>
)}
